# Copy to .env and adjust. Nothing secret belongs in this file.

# --- Database -------------------------------------------------------------
# The app connects as a NON-SUPERUSER role on purpose: a superuser silently
# bypasses row level security, which would make the tenant boundary a lie.
# scripts/bootstrap_db.sh creates this role and database for you.
POSTGRES_DB=dealeros
POSTGRES_USER=dealeros_app
POSTGRES_PASSWORD=dealeros_app
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_DEBUG=1

# --- Demo users (seeded by `manage.py seed_users`) ------------------------
DEMO_PASSWORD=demo-password

# --- Grounded answer endpoint --------------------------------------------
# Leave LLM_API_KEY empty to use the built-in deterministic planner, which is
# what the test suite uses. Set it to enable the LLM planner.
# BRING YOUR OWN KEY. Never commit it.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# --- Break-glass switch used only for the walkthrough --------------------
# Set to 1 to build the database WITHOUT row level security, so you can watch
# the isolation tests fail. See WALKTHROUGH.md.
DEALEROS_DISABLE_RLS=
